! Inviscid slip diagnostic: fixed ellipsoid in uniform inflow/outflow.
! Streamwise semi-axis is longer than transverse axes; net force should decay toward zero.

&BasicParam
itype = 16

p_row=0
p_col=0

nx=65
ny=64
nz=64
istret = 0
beta = 0.259065151

xlx = 5.0
yly = 5.0
zlz = 5.0

nclx1 = 2
nclxn = 2
ncly1 = 0
nclyn = 0
nclz1 = 0
nclzn = 0

iin = 1
re  = 0.0
u1  = 1.0
u2  = 1.0
init_noise  = 0.0
inflow_noise = 0.0

dt = 0.001
ifirst = 1
ilast = 200

ilesmod=0
iscalar=0
iibm=3
/End

&NumOptions
ifirstder = 4
isecondder = 4
ipinter = 3
itimescheme = 3
/End

&InOutParam
irestart = 0
icheckpoint = 999999
ioutput = 99999
ilist = 20
nvisu = 1
validation_restart = .false.
/End

&Statistics
nstat = 1
initstat = 100000
/End

&ScalarParam
numscalar = 0
Sc = 0.2
/End

&LESModel
jles = 0
smagcst = 0.14
SmagWallDamp = 1
walecst = 0.5
iconserv = 0
/End

&ibmstuff
imove=1
ce=2.5,2.5,2.5
sh=0.9,0.45,0.45
ori=1.0,0.0,0.0,0.0
lv=0.0,0.0,0.0
av=0.0,0.0,0.0
rho_s=1000000000.0
ra=0.3
nraf=10
nobjmax=1
iforces=1
nvol=1
bodies_fixed=1
torques_flag=1
orientations_free=0
torq_debug=0
torq_flip=1
cvl_scalar=3.0
nbody=1
/End

&ForceCVs
xld(1) = 1.6
xrd(1) = 3.4
yld(1) = 1.6
yud(1) = 3.4
zld(1) = 1.6
zrd(1) = 3.4
/End

&CASE
/End
